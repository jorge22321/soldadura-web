{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "",
    "buildCommand": "",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "excludeFiles": "{node_modules/**,tests/**,.agents/**,.claude/**,.codex/**,.git/**,storage/**,database/**}"
        }
    },
    "routes": [
        { "src": "/(build|fonts|images)/(.*)", "dest": "/$1/$2" },
        { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/$1" },
        { "src": "/(?:|nosotros|servicios(?:/[^/]+)?|proyectos|preguntas-frecuentes|contacto|blog(?:/.*)?|productos|up)/?", "dest": "/api/index.php" },
        { "src": "/.*", "status": 404 }
    ],
    "env": {
        "APP_NAME": "Industrias Aldo",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "es",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "QUEUE_CONNECTION": "sync",
        "APP_CONFIG_CACHE": "/tmp/aldo-config.php",
        "APP_EVENTS_CACHE": "/tmp/aldo-events.php",
        "APP_PACKAGES_CACHE": "/tmp/aldo-packages.php",
        "APP_ROUTES_CACHE": "/tmp/aldo-routes.php",
        "APP_SERVICES_CACHE": "/tmp/aldo-services.php",
        "VIEW_COMPILED_PATH": "/tmp/industrias-aldo/framework/views"
    }
}
